{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https:; media-src 'self' https:; frame-src 'self' https:;"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/exhibitions.html",
      "destination": "/exhibitions",
      "permanent": true
    },
    {
      "source": "/events.html",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/fitouts.html",
      "destination": "/fitouts",
      "permanent": true
    },
    {
      "source": "/retail.html",
      "destination": "/retail",
      "permanent": true
    },
    {
      "source": "/hct-case-study.html",
      "destination": "/case-studies#hct-graduation-program",
      "permanent": true
    },
    {
      "source": "/hct-case-study",
      "destination": "/case-studies#hct-graduation-program",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
