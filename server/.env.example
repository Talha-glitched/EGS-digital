PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=
PUBLIC_APP_URL=http://localhost:5000
# For production outreach, set this to your public HTTPS URL (e.g. https://crm.exhibitgraphicsign.com).
# When left on localhost, open-tracking pixels are omitted so Gmail/clients are not sent broken links.

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

EMAIL_SMTP_HOST=mail.exhibitgraphicsign.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=talha@exhibitgraphicsign.com
EMAIL_SMTP_PASS=
# SMTP uses strict TLS by default. Keep this true in production.
EMAIL_SMTP_TLS_REJECT_UNAUTHORIZED=true
# Optional display name for From header (test send + campaigns)
EMAIL_FROM_NAME=Exhibit Graphic Sign
EMAIL_IMAP_HOST=mail.exhibitgraphicsign.com
EMAIL_IMAP_PORT=993
# IMAP uses strict TLS by default. Set to false if you see "self-signed certificate in certificate chain"
# (dev only unless you trust the network). Prefer trusting your CA via NODE_EXTRA_CA_CERTS in production.
EMAIL_IMAP_TLS_REJECT_UNAUTHORIZED=true
# Optional fallback if EMAIL_IMAP_TLS_REJECT_UNAUTHORIZED is unset:
# EMAIL_TLS_REJECT_UNAUTHORIZED=true
# Reply sync: how far back to search INBOX (days), and max messages to process per sync (newest first if capped)
EMAIL_IMAP_SYNC_DAYS=120
EMAIL_IMAP_SYNC_MAX_MESSAGES=4000
# Append SMTP outbound copies to this IMAP folder so they appear in cPanel/webmail Sent.
EMAIL_IMAP_SAVE_SENT=true
EMAIL_IMAP_SENT_FOLDER=INBOX.Sent
# Max UIDs considered when building the live inbox list (before limit= query cap)
EMAIL_IMAP_RAW_LIST_MAX=600

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_COST_PER_1K_TOKENS=0.00015
OPENAI_USD_TO_AED=3.6725
MAILBOX_DAILY_CAP=150
IMAP_WATCH_INTERVAL_MS=180000
