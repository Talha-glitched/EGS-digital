PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=
PUBLIC_APP_URL=http://localhost:5000
# For production outreach, set this to your public HTTPS URL (e.g. https://crm.exhibitgraphicsign.com).
# When left on localhost, open-tracking pixels are omitted so Gmail/clients are not sent broken links.

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Mailbox server configuration
EMAIL_SMTP_HOST=mail.exhibitgraphicsign.com
EMAIL_SMTP_PORT=465
# SMTP uses strict TLS by default. Keep this true in production.
EMAIL_SMTP_TLS_REJECT_UNAUTHORIZED=true
# Optional default display name for From header (test send + campaigns)
EMAIL_FROM_NAME=Exhibit Graphic Sign

# Account 1 (Primary System Sender)
EMAIL_SMTP_USER=haider@exhibitgraphicsign.com
EMAIL_SMTP_PASS=
EMAIL_SMTP_USER_NAME=Dr. Haider
EMAIL_SMTP_USER_TITLE=Project Director · Exhibit Graphic Sign LLC

# Account 2 (Secondary Outreach)
EMAIL_SMTP_USER2=masuood@exhibitgraphicsign.com
EMAIL_SMTP_USER2_PASS=
EMAIL_SMTP_USER2_NAME=Masuood-ul-Rasheed
EMAIL_SMTP_USER2_TITLE=Managing Director · Exhibit Graphic Sign LLC

# Account 3 (Additional Sender)
EMAIL_SMTP_USER3=talha@exhibitgraphicsign.com
EMAIL_SMTP_USER3_PASS=
EMAIL_SMTP_USER3_NAME=Talha Masuood
EMAIL_SMTP_USER3_TITLE=Operations & Technical Director · Exhibit Graphic Sign LLC

# Alternatively, configure via JSON array:
# EMAIL_ACCOUNTS=[{"email":"talha@exhibitgraphicsign.com","pass":"...","name":"Talha Masuood","title":"Director"},{"email":"masuood@exhibitgraphicsign.com","pass":"...","name":"Masuood-ul-Rasheed","title":"Project Director"}]

EMAIL_IMAP_HOST=wardah.tasjeel.ae
EMAIL_IMAP_PORT=993
# IMAP uses strict TLS by default. Set to false if you see "self-signed certificate in certificate chain"
EMAIL_IMAP_TLS_REJECT_UNAUTHORIZED=false
EMAIL_IMAP_SYNC_DAYS=120
EMAIL_IMAP_SYNC_MAX_MESSAGES=4000
EMAIL_IMAP_SAVE_SENT=true
EMAIL_IMAP_SENT_FOLDER=INBOX.Sent
EMAIL_IMAP_RAW_LIST_MAX=600

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_COST_PER_1K_TOKENS=0.00015
OPENAI_USD_TO_AED=3.6725
MAILBOX_HOURLY_CAP=150
MAILBOX_DAILY_CAP=1500
IMAP_WATCH_INTERVAL_MS=180000
